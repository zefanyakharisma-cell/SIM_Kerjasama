# Supabase (public — safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose
SUPABASE_SERVICE_ROLE_KEY=
# Local Postgres URL used by `npm run db:test`
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public origin, used to build the partner evaluation link the unit emails.
# Falls back to the request host when unset.
NEXT_PUBLIC_APP_URL=

# The Partnership Realization System's read-API key (Phase 4). Server only.
# One shared key for one consumer; a per-client table belongs here once there
# is a second one.
REALIZATION_API_KEY=

# Email dispatch, used by the kirim-email Edge Function (set as Supabase
# function secrets, not in this file).
#   RESEND_API_KEY=
#   EMAIL_FROM=
#   APP_URL=
